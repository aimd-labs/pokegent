{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Pokegent evaluation attempt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "segment_id",
    "campaign_id",
    "scenario_family",
    "layer",
    "source_commit",
    "artifact_sha256",
    "game_profile",
    "rom_sha256",
    "initial_state_sha256",
    "fixture_id",
    "backend",
    "backend_version",
    "host",
    "config_sha256",
    "profile_sha256",
    "prompt_sha256",
    "adapter_sha256",
    "decider_mode",
    "knowledge_policy",
    "preparation",
    "seed_lineage",
    "objective_id",
    "required_probes",
    "budgets",
    "provider_ids",
    "status",
    "operator_interventions",
    "result_receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "pokegent-evaluation/1"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "segment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scenario_family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "layer": {
      "enum": [
        "L0",
        "L1",
        "L2a",
        "L2b",
        "L3",
        "L4"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "game_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "rom_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "initial_state_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fixture_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "backend": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "backend_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "adapter_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "decider_mode": {
      "enum": [
        "agent",
        "system1",
        "hybrid",
        "mock",
        "deterministic"
      ]
    },
    "knowledge_policy": {
      "enum": [
        "fair_play",
        "guide",
        "synthetic"
      ]
    },
    "preparation": {
      "enum": [
        "synthetic",
        "replay",
        "simulator",
        "cold_boot",
        "reviewed_checkpoint",
        "modified_fixture"
      ]
    },
    "seed_lineage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "objective_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "required_probes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "action_decisions",
        "provider_requests"
      ],
      "properties": {
        "wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "action_decisions": {
          "type": "integer",
          "minimum": 1
        },
        "provider_requests": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provider_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "status": {
      "enum": [
        "planned",
        "completed",
        "failed",
        "timed_out",
        "censored",
        "infrastructure_invalid"
      ]
    },
    "operator_interventions": {
      "type": "integer",
      "minimum": 0
    },
    "result_receipt_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layer": {
            "enum": [
              "L2b",
              "L3",
              "L4"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "game_profile": {
            "type": "string",
            "minLength": 1
          },
          "rom_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "initial_state_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "preparation": {
            "enum": [
              "reviewed_checkpoint",
              "modified_fixture"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "initial_state_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "result_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
