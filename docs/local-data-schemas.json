  "prompt_rules.yaml": {
    "$defs": {
      "PromptRule": {
        "additionalProperties": true,
        "properties": {
          "kind": {
            "enum": [
              "heal",
              "field_move",
              "poke_flute",
              "fossil_choice",
              "secret_switch",
              "quiz",
              "destructive",
              "item_receive",
              "unknown",
              "unreadable",
              "pc_storage_error"
            ],
            "title": "Kind",
            "type": "string"
          },
          "patterns": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Patterns",
            "type": "array"
          },
          "default_yes": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Default Yes"
          },
          "field_move": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Field Move"
          },
          "irreversible": {
            "default": false,
            "title": "Irreversible",
            "type": "boolean"
          },
          "wrong_answer_cost": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Wrong Answer Cost"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          }
        },
        "required": [
          "kind",
          "patterns"
        ],
        "title": "PromptRule",
        "type": "object"
      }
    },
    "additionalProperties": true,
    "properties": {
      "rules": {
        "items": {
          "$ref": "#/$defs/PromptRule"
        },
        "title": "Rules",
        "type": "array"
      }
    },
    "required": [
      "rules"
    ],
    "title": "PromptRules",
    "type": "object"
  },
